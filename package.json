{
  "name": "nook",
  "version": "0.8.0",
  "private": true,
  "description": "A companion window that lives at the top of the screen.",
  "author": "Nook contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoeslovevid/Nook-Interactive-Assistant.git"
  },
  "main": "main.js",
  "scripts": {
    "brand": "electron scripts/build-brand.cjs",
    "smoke:workspace": "electron scripts/smoke-workspace.cjs",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "smoke:experience": "electron scripts/smoke-experience.cjs",
    "smoke:everyday": "electron scripts/smoke-everyday.cjs",
    "smoke:studio": "electron scripts/smoke-studio.cjs",
    "smoke:chat": "electron scripts/smoke-chat.cjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  }
}
