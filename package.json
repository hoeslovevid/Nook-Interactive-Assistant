{
  "name": "nook",
  "version": "0.11.2",
  "private": true,
  "description": "A companion window that lives at the top of the screen.",
  "author": "Nook contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoeslovevid/Nook-Interactive-Assistant.git"
  },
  "main": "main.js",
  "scripts": {
    "brand": "electron scripts/build-brand.cjs",
    "smoke:workspace": "electron scripts/smoke-workspace.cjs",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "smoke:experience": "electron scripts/smoke-experience.cjs",
    "smoke:everyday": "electron scripts/smoke-everyday.cjs",
    "smoke:studio": "electron scripts/smoke-studio.cjs",
    "smoke:chat": "electron scripts/smoke-chat.cjs",
    "smoke:next": "electron scripts/smoke-next.cjs",
    "smoke:library": "electron scripts/smoke-library.cjs",
    "smoke:modern": "electron scripts/smoke-modern.cjs",
    "smoke:refinements": "electron scripts/smoke-refinements.cjs",
    "smoke:notch": "electron scripts/smoke-notch-stability.cjs",
    "smoke:polish": "electron scripts/smoke-polish.cjs",
    "smoke:local-ai": "node scripts/smoke-local-ai.cjs",
    "smoke:local-ui": "electron scripts/smoke-local-ui.cjs",
    "smoke:pet": "electron scripts/smoke-pet-animations.cjs",
    "smoke:expansion": "electron scripts/smoke-expansion.cjs",
    "smoke:refined": "electron scripts/smoke-refined.cjs",
    "smoke:hub": "electron scripts/smoke-hub.cjs",
    "previews:release": "electron scripts/capture-release-previews.cjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "ignore": "7.0.5",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  }
}
